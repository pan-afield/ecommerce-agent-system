# Local PostgreSQL/pgvector container. Change these values in .env when needed.
POSTGRES_DB=ecommerce_agents
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Shared relational database URL. Prisma reads it directly; Agent Core selects asyncpg internally.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce_agents

# Server-side HS256 signing secret used to verify JWT access tokens.
# Generate a local value with: openssl rand -hex 32
# Never commit the generated value.
JWT_SECRET_KEY=

# JWT token issuer expected by Agent Core.
JWT_ISSUER=ecommerce-agent-system

# Access Token 有效期，单位：秒
JWT_ACCESS_TOKEN_TTL_SECONDS=900

# Refresh Token 有效期，单位：秒
JWT_REFRESH_TOKEN_TTL_SECONDS=2592000

# Authenticated user ID allowed to approve refunds in V0.5.
# This is a temporary single-approver boundary; leave blank to disable approval.

# Server-only local demo gate for browser-triggered approval. Keep false outside local demos.
# A production UI must use a real signed-in approver session instead of this service identity.
AGENT_CORE_REFUND_APPROVAL_DEMO_ENABLED=false

# Server-only demo identity used by the Next.js BFF when issuing a short-lived local token.
# V0.4 has no login/token-issuer endpoint yet. Never expose this through NEXT_PUBLIC_*.
AGENT_CORE_DEMO_USER_ID=demo-user-li

# Server-only URL used by the Next.js BFF to reach Agent Core.
# Do not expose it through a NEXT_PUBLIC_ variable.
AGENT_CORE_URL=http://localhost:8000

# OpenAI-compatible chat configuration.
# Keep real credentials in .env; never commit them.
OPENAI_API_KEY=

# Leave blank to use the official OpenAI API.
# A compatible proxy can provide its API root here.
OPENAI_BASE_URL=

# Low-cost default; local .env may override it.
OPENAI_AGENT_MODEL=gpt-4.1-mini

# Optional: none, low, medium, high, xhigh, or max.
OPENAI_REASONING_EFFORT=

# Keep true for the Responses API path used by this project.
OPENAI_USE_RESPONSES_API=true

# Per-request timeout in seconds. Must be greater than 0 and at most 120.
OPENAI_REQUEST_TIMEOUT_SECONDS=30

# Agent Core settings use the AGENT_CORE_ prefix.
AGENT_CORE_ENVIRONMENT=development
AGENT_CORE_DOCS_ENABLED=true

# Local HuggingFace embedding model used by the knowledge-base retrieval pipeline.
RAG_EMBEDDING_MODEL=BAAI/bge-m3

# Must match the model's vector size and the pgvector column dimension.
RAG_EMBEDDING_DIMENSIONS=1024

# Optional local model cache directory. Leave blank to use the library default.
RAG_EMBEDDING_CACHE_DIR=

# Runtime device for the local model. CPU is the supported default; CUDA can be used when available.
RAG_EMBEDDING_DEVICE=cpu

# Optional Redis 7+ for RAG cache and per-user rate limiting (EXPIRE NX requires 7+).
# Leave blank to disable both. Redis errors allow requests through without enforcing the limit.
REDIS_URL=
# Cache lifetime in seconds.
REDIS_CACHE_TTL_SECONDS=30

# Positive integers. Chat and chat/stream share a user quota; RAG has a separate user quota.
# A window starts with the first request. These values are not the RAG citation limit.
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
