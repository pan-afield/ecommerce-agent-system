# Local PostgreSQL/pgvector container. Change these values in .env when needed.
POSTGRES_DB=ecommerce_agents
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Shared relational database URL. Prisma reads it directly; Agent Core selects asyncpg internally.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce_agents

# Browser/server callers use this base URL to reach the Python service.
AGENT_CORE_URL=http://localhost:8000

# Reserved for a later model-integration phase. Keep real keys in .env, never in source control.
OPENAI_API_KEY=

# Agent Core settings use the AGENT_CORE_ prefix.
AGENT_CORE_ENVIRONMENT=development
AGENT_CORE_DOCS_ENABLED=true
