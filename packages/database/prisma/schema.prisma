generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum RefundStatus {
  AWAITING_CUSTOMER_CONFIRMATION
  PENDING_MANUAL_APPROVAL
  APPROVED
  REJECTED
}

enum UserRole {
  CUSTOMER
  SUPPORT
  ADMIN
}

/// The partial unique index for one non-rejected application per user/order
/// is owned by migration 20260824090000_enforce_single_non_rejected_refund.
model RefundApplication {
  id               String       @id @db.VarChar(64)
  userId           String       @map("user_id") @db.VarChar(64)
  orderId          String       @map("order_id") @db.VarChar(64)
  requestId        String       @map("request_id") @db.VarChar(128)
  requestedAmount  Decimal      @map("requested_amount") @db.Decimal(12, 2)
  currency         String       @db.Char(3)
  status           RefundStatus
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  confirmedAt      DateTime?    @map("confirmed_at") @db.Timestamptz(3)
  user             User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  reviewedByUserId String?      @map("reviewed_by_user_id") @db.VarChar(64)
  reviewedAt       DateTime?    @map("reviewed_at") @db.Timestamptz(3)
  reviewNote       String?      @map("review_note") @db.VarChar(500)

  @@unique([userId, requestId])
  @@index([orderId])
  @@map("refund_applications")
}

model RefreshToken {
  id        String    @id @db.VarChar(64)
  userId    String    @map("user_id") @db.VarChar(64)
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

model User {
  id                 String              @id @db.VarChar(64)
  name               String              @db.VarChar(100)
  email              String              @unique @db.VarChar(255)
  passwordHash       String?             @map("password_hash") @db.VarChar(255)
  refreshTokens      RefreshToken[]
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  orders             Order[]
  refundApplications RefundApplication[]
  role               UserRole            @default(CUSTOMER)

  @@map("users")
}

model Order {
  id                 String              @id @db.VarChar(64)
  userId             String              @map("user_id") @db.VarChar(64)
  orderNumber        String              @unique @map("order_number") @db.VarChar(32)
  status             OrderStatus
  totalAmount        Decimal             @map("total_amount") @db.Decimal(12, 2)
  currency           String              @default("CNY") @db.Char(3)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  shipmentEvents     ShipmentEvent[]
  refundApplications RefundApplication[]

  @@index([userId])
  @@map("orders")
}

model ShipmentEvent {
  id          String   @id @db.VarChar(64)
  orderId     String   @map("order_id") @db.VarChar(64)
  status      String   @db.VarChar(50)
  description String   @db.VarChar(255)
  location    String?  @db.VarChar(100)
  occurredAt  DateTime @map("occurred_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, occurredAt])
  @@map("shipment_events")
}

// Prisma owns conventional relational business data. Vector indexes, retrieval
// chunks, checkpoints, and agent runtime state remain outside this schema.

model RefundExecution {
  id                  String             @id @db.VarChar(64)
  refundApplicationId String             @unique @map("refund_application_id") @db.VarChar(64)
  idempotencyKey      String             @unique @map("idempotency_key") @db.VarChar(128)
  status              String             @db.VarChar(32)
  providerReference   String?            @map("provider_reference") @db.VarChar(128)
  amount              Decimal            @db.Decimal(12, 2)
  currency            String             @db.Char(3)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @default(now()) @map("updated_at") @db.Timestamptz(3)
  auditEvents         RefundAuditEvent[]
  recoveryJob         RefundRecoveryJob?

  @@map("refund_executions")
}

/// Trigger-owned state transitions and append-only guard live in the V1.0 migration.
model RefundAuditEvent {
  id                BigInt          @id @default(autoincrement())
  executionId       String          @map("execution_id") @db.VarChar(64)
  action            String          @db.VarChar(32)
  source            String          @db.VarChar(32)
  actorUserId       String?         @map("actor_user_id") @db.VarChar(64)
  sourceEventId     String?         @map("source_event_id") @db.VarChar(128)
  fromStatus        String?         @map("from_status") @db.VarChar(32)
  toStatus          String?         @map("to_status") @db.VarChar(32)
  providerReference String?         @map("provider_reference") @db.VarChar(128)
  errorCode         String?         @map("error_code") @db.VarChar(64)
  note              String?         @db.VarChar(500)
  createdAt         DateTime        @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)
  execution         RefundExecution @relation(fields: [executionId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([executionId, id])
  @@map("refund_audit_events")
}

/// PostgreSQL also enforces the status/lease pair and non-negative attempt count.
model RefundRecoveryJob {
  executionId    String          @id @map("execution_id") @db.VarChar(64)
  status         String          @default("READY") @db.VarChar(32)
  attempts       Int             @default(0)
  nextAttemptAt  DateTime        @default(dbgenerated("clock_timestamp()")) @map("next_attempt_at") @db.Timestamptz(3)
  leaseToken     String?         @map("lease_token") @db.Uuid
  leaseExpiresAt DateTime?       @map("lease_expires_at") @db.Timestamptz(3)
  lastErrorCode  String?         @map("last_error_code") @db.VarChar(64)
  updatedAt      DateTime        @default(dbgenerated("clock_timestamp()")) @map("updated_at") @db.Timestamptz(3)
  execution      RefundExecution @relation(fields: [executionId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([status, nextAttemptAt])
  @@map("refund_recovery_jobs")
}

model RefundWebhookEvent {
  eventId           String   @id @map("event_id") @db.VarChar(128)
  idempotencyKey    String   @map("idempotency_key") @db.VarChar(128)
  status            String   @db.VarChar(32)
  providerReference String?  @map("provider_reference") @db.VarChar(128)
  receivedAt        DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  @@index([idempotencyKey, receivedAt])
  @@map("refund_webhook_events")
}

/// Local-only simulated payment provider; no real funds or customer payment credentials.
model SandboxRefund {
  idempotencyKey    String              @id @map("idempotency_key") @db.VarChar(128)
  payloadHash       String              @map("payload_hash") @db.Char(64)
  status            String              @default("PROCESSING") @db.VarChar(32)
  providerReference String?             @map("provider_reference") @db.VarChar(128)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  event             SandboxRefundEvent?

  @@map("sandbox_refunds")
}

model SandboxRefundEvent {
  eventId           String        @id @map("event_id") @db.VarChar(128)
  idempotencyKey    String        @unique @map("idempotency_key") @db.VarChar(128)
  status            String        @db.VarChar(32)
  providerReference String?       @map("provider_reference") @db.VarChar(128)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  refund            SandboxRefund @relation(fields: [idempotencyKey], references: [idempotencyKey], onDelete: NoAction, onUpdate: NoAction)

  @@map("sandbox_refund_events")
}
